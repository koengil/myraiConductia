    "seed": "npm run seed:flags && npm run seed:users",
    "check:db": "node --env-file=.env.local --import tsx scripts/check-db.ts",
    "check:pg": "bash scripts/check-pg.sh",
    "check:migrations": "node --import tsx scripts/check-migration-prefixes.ts",
    "preflight:db": "node --import tsx scripts/preflight-db.ts",
