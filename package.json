    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "serialize-error": "^13.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
