    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "demo:spine": "node --import tsx scripts/demo-spine.ts",
    "seed:flags": "node --env-file=.env.local --import tsx scripts/seed-flags.ts",
    "smoke:box": "node --env-file=.env.local --import tsx scripts/smoke-box.ts",
    "smoke:resend": "node --env-file=.env.local --import tsx scripts/smoke-resend.ts",
    "seed:users": "node --env-file=.env.local --import tsx scripts/seed-users.ts",
