    "google:seed-gmail": "node --env-file=.env.local --import tsx scripts/google/seed-gmail.ts",
    "google:seed-drive": "node --env-file=.env.local --import tsx scripts/google/seed-drive.ts",
    "google:record-replay": "node --env-file=.env.local --import tsx scripts/google/record-replay.ts",
    "google:merge-replay": "node --import tsx scripts/google/merge-replay.ts",
    "google:build-twin": "node --import tsx scripts/google/build-gmail-twin.ts",
    "sandbox:generate-gmail": "node --import tsx scripts/sandbox/generate-gmail.ts",
    "sandbox:seed-firm": "node --env-file-if-exists=.env.local --import tsx scripts/sandbox/seed-sandbox-firm.ts"
