    "dev:mint-invite": "node --env-file=.env.local --import tsx scripts/dev-mint-invite-credentials.ts",
    "dev:create-invite": "node --env-file=.env.local --import tsx scripts/dev-create-company-invite.ts",
    "grant:mock-book": "node --env-file=.env.local --import tsx scripts/grant-mock-book.ts",
