# Conductia environment. Copy to .env.local (git-ignored) and fill in. Never
# commit real keys. .env.local points at the local Supabase stack
# (supabase start, http://127.0.0.1:54321). The hosted development project
# lives in .env.development, which Next loads underneath .env.local.

# dev | staging | prod
NEXT_PUBLIC_APP_ENV=dev

# The deployment's own public origin. Invite and resend links are built against
# it; when unset they fall back to the origin of the incoming request, so a
# script or proxy calling the API on another host mints links pointing at that
# host. Required outside dev (`npm run preflight:env` checks it). The same
# origin must be allowlisted in Supabase -> Authentication -> URL Configuration
# (Site URL, plus a `/**` redirect pattern) or GoTrue silently rewrites it.
# NEXT_PUBLIC_APP_URL=https://app.conductia.com

# The /dev-api Swagger console and the /api/v1/openapi.json document it renders.
# Both are open under `next dev` and 404 in any production build; set this on a
# single deployment ('true' / '1') to open them there too. Server-only on
# purpose — deliberately NOT NEXT_PUBLIC_*, so it is never inlined into the
# client bundle. Leave unset: the document maps the whole v1 surface, including
# auth rules, feature flag names and permission keys.
# ENABLE_DEV_API=true

# Local testing only (dev): optionally skip Supabase TOTP AAL2 in middleware + /api/v1.
# Leave unset for normal 2FA. Set both when you need to bypass locally.
# DISABLE_MFA=true
# NEXT_PUBLIC_DISABLE_MFA=true

# Development-only selective policy: existing accounts may stay at AAL1, but
# accounts created by the email-invite pipeline must enroll/challenge at AAL2.
# This takes precedence over DISABLE_MFA when both are set. Non-dev environments
# ignore it and continue requiring MFA for every account.
# MFA_ENFORCEMENT=invite_only

# Supabase — new key system (publishable + secret), not the deprecating legacy JWT.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Browser-safe with RLS enabled (replaces anon).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses RLS — must never reach the browser (replaces service_role).
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection — only for `npm run db:migrate` / `check:pg` and for
# TablePlus. Copy from Supabase: Settings -> Database -> Connection string ->
# Session pooler (IPv4). Uses the DB password, NOT the API keys above.
# CI reads production from secret PRODUCTION_DATABASE_URL on environment production-db.
DATABASE_URL=

# Seed scripts only. Min 8 characters. Never use in prod.
#   `npm run seed:users` — the dev fixture roster (<slug>.intelibank@dev.com),
#     sample deals and documents. Resets the password of every account it owns.
#   `scripts/seed-team.ts` — the real team accounts. Sets this password on NEW
#     accounts only; an existing one is never touched.
SEED_PASSWORD=

# scripts/seed-team.ts only. Which roster to apply: 'dev' (default) is the whole
# team, 'prod' is Storm and Dan only. Any other value refuses rather than
# guessing who belongs on a database.
# SEED_ROSTER=dev
# TEAM_COMPANY_NAME=Conductia
# TEAM_COMPANY_DOMAIN=conductia.com

# Server-only keyed-digest secret for invite recipient verification codes.
# Generate a high-entropy value independently in every environment. Rotating it
# invalidates outstanding codes, which must then be reissued through resend.
INVITE_VERIFICATION_PEPPER=

# Resend (server-only). Invitation mail uses RESEND_FROM; the screened outbox
# uses EMAIL_FROM. Both must be on a verified Resend domain. The
# onboarding@resend.dev sandbox only delivers to the account owner's inbox —
# Resend still answers 200, so an unset sender is a green UI and no email.
# Outside dev both are REQUIRED: unset or resend.dev now throws at send time
# rather than degrading silently. `npm run preflight:env` checks them, plus
# RESEND_API_KEY (missing, with no explicit EMAIL_PROVIDER=noop, simulates the
# send while the audit row reads as sent).
# RESEND_API_KEY=re_...
# RESEND_FROM=Conductia <info@conductia.com>
# EMAIL_FROM=Conductia <info@conductia.com>
# EMAIL_PROVIDER=resend
# Dev-only override of the Resend origin, for the e2e mail stub. Refused with a
# hard error unless NEXT_PUBLIC_APP_ENV=dev: a mis-set value in a deployed
# environment would send the API key to whatever origin it names.
# RESEND_API_BASE=http://127.0.0.1:4310

# Server-only HMAC key for the mail send-as-is token (the first screen's read,
# bound to the content, sender and deal it was about — #192). The mail channel
# REQUIRES one of the two: when this is unset, a purpose-derived key from
# INVITE_VERIFICATION_PEPPER is used; with neither set, every send fails with
# a clean 500 before anything is screened. Rotating either invalidates
# outstanding tokens; the sender simply gets a fresh screen.
# OUTBOX_SCREEN_SECRET=

# The discovery message index's digest key (#461, D93; worker only). Each
# tenant's HMAC key is derived from it, so an index row's content digest cannot
# confirm a guessed message without it. At least 32 characters
# (openssl rand -hex 32). Required where NEXT_PUBLIC_APP_ENV=prod; elsewhere a
# fixed development key stands in. Rotating it makes the next read re-process
# and re-key every indexed message.
# DISCOVERY_INDEX_DIGEST_KEY=

# Personal mailbox connection — Microsoft 365 via Graph OAuth (server-only).
# Azure Portal -> App registrations. Delegated scopes: offline_access, User.Read,
# Mail.Send. All four of CLIENT_ID / CLIENT_SECRET / REDIRECT_URI /
# MAILBOX_TOKEN_KEY must be set, or /api/v1/mailbox reports configured:false and
# the Connect button is not offered. Behind the mail_channel feature flag.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_REDIRECT_URI=http://localhost:3000/api/v1/mailbox/callback
# Directory the app signs users in from. 'common' (the default) is any tenant.
# MS_TENANT=common
# AES-256-GCM key encrypting the stored OAuth tokens at rest. EXACTLY 32 bytes,
# hex or base64: `openssl rand -hex 32`. Rotating it orphans every stored
# connection — people simply reconnect.
# MAILBOX_TOKEN_KEY=

# Gmail send as the banker (#490, ADR-0025; server-only). A separate OAuth web
# client from Google sign-in and the Workspace reader, scoped to openid, email
# and gmail.send. All three below plus MAILBOX_TOKEN_KEY (above) must be set or
# Gmail sending is not offered. Setup: docs/03-engineering/gmail-send-runbook.md.
# GOOGLE_SEND_CLIENT_ID=
# GOOGLE_SEND_CLIENT_SECRET=
# GOOGLE_SEND_REDIRECT_URI=http://localhost:3000/api/v1/mailbox/google/callback

# Inbound mail webhook (server-only). The provider (Resend inbound) posts to
# /api/v1/inbound/webhook?tenant=<uuid> with this value in the x-inbound-secret
# header; it is compared constant-time. Unset means the route answers 503 rather
# than accepting anything. Generate independently per environment.
# INBOUND_WEBHOOK_SECRET=

# Box Content API (server-only). When unset, datarooms run in mock mode locally.
# Create a Box Custom App with Client Credentials Grant (enterprise scope).
BOX_CLIENT_ID=
BOX_SECRET=
BOX_ENTERPRISE_ID=
# Optional legacy alias for BOX_SECRET:
# BOX_CLIENT_SECRET=
# Short-lived developer token from the Box console. Takes precedence over the
# three above and skips the token exchange entirely — handy for a quick local
# poke, useless after an hour. Never deploy one.
# BOX_DEV_TOKEN=
# Deal folders partition under /{develop|staging|production}/… derived from
# NEXT_PUBLIC_APP_ENV (dev → develop, staging → staging, prod → production).
# Set STORAGE_PROVIDER=box to route onboarding uploads through Box.
# STORAGE_PROVIDER=box

# Ignatious (server-only). The inbound key never reaches the browser.
#
# Locally RTS still runs two processes. Deployed, one hostname serves both
# halves: `/v1` (control plane) and `/v1/bench` (skill bench) behind the same
# x-api-key. The agent runner reuses the control-plane host when
# IGNATIOUS_SKILL_BENCH_URL is unset; skill publication does not, so set it
# explicitly wherever skill publication runs (`npm run preflight:env` checks).
#
# Local (two services):
# IGNATIOUS_CONTROL_PLANE_URL=http://localhost:4111
# IGNATIOUS_SKILL_BENCH_URL=http://localhost:4212
# IGNATIOUS_API_KEY=local-dev-key
#
# Deployed (one URL):
# IGNATIOUS_API_URL=https://api.conductia-prototype.com
# IGNATIOUS_CONTROL_PLANE_URL=https://api.conductia-prototype.com
# IGNATIOUS_SKILL_BENCH_URL=https://api.conductia-prototype.com
# IGNATIOUS_API_KEY=
# Required on a production deploy (the build fails without it); elsewhere it
# defaults to tn_demo.
# IGNATIOUS_TENANT_ID=tn_demo
# Optional. Leave unset so md-briefing reads THIS deal (company + contacts).
# Set only to pin every rail onto one mock/demo lead (e.g. lead_halyard_demo).
# Refused on a production deploy (VERCEL_ENV=production): agent runs return 503.
# IGNATIOUS_LEAD_ID=
# Public origin Ignatious should call back into (`/v1/leads/...`). Must be on
# their CONDUCTIA_ALLOWED_BASE_URLS or the request is 403 scope_denied.
# Local: set this if you want write-back to this machine. Vercel preview:
# leave unset (a *.vercel.app host will be refused). Production uses the
# project custom domain automatically once RTS allowlists it.
# CONDUCTIA_PUBLIC_URL=http://localhost:3000

# Skill publication (server-only). Outbound credential Conductia presents to
# Ignatious' skill-publication routes, kept separate from IGNATIOUS_API_KEY.
# Needs IGNATIOUS_SKILL_BENCH_URL set explicitly (above); without it, or when
# the token equals IGNATIOUS_API_KEY or IGNATIOUS_AUTHORING_SERVICE_TOKEN,
# publication, rail-template imports and lineage are off.
# Inbound credentials accepted by the recovery sweep route. Vercel's cron job
# presents CRON_SECRET; the processor token is for driving the sweep by hand.
# IGNATIOUS_PUBLICATION_SERVICE_TOKEN=
# Authoring credential; must differ from the publication token.
# IGNATIOUS_AUTHORING_SERVICE_TOKEN=
# CRON_SECRET=
# SKILL_PUBLICATION_PROCESSOR_TOKEN=
# SKILL_PUBLICATION_PROCESSOR_TOKEN_PREVIOUS=

# Server-only HMAC key for the Ignatious trigger token. We mint the token,
# Ignatious forwards it back verbatim on every `/v1/leads/...` callback, and
# the seam verifies this signature before it trusts a single claim. When this
# is unset a purpose-derived key from INVITE_VERIFICATION_PEPPER is used; with
# neither set the seam cannot verify a token at all and only IGNATIOUS_API_KEY
# authenticates. Rotating either invalidates tokens for runs already in
# flight; the skill is simply re-triggered.
# CONDUCTIA_TRIGGER_TOKEN_SECRET=
#
# How the seam treats a token it cannot verify. Unset means `enforce`, which
# refuses it. Set `observe` ONLY for the migration window: it accepts the
# token, trusts nothing it carries, and logs one `legacy_unsigned` line per
# call so the deployment can prove what its agents backend actually presents
# before the legacy path is closed. Anything other than `observe` is treated
# as `enforce`, so a misspelling fails closed.
# CONDUCTIA_TRIGGER_TOKEN_MODE=observe

# Vercel AI Gateway (server-only). Every model call the app makes (the compliance
# LLM screen, Gate 0 code-name themes, the discovery extract) sends through it with
# zero data retention, Anthropic only. Blank means no model call: the screen runs
# rules only and code names use the fallback sets. Also read by the Jev eval.
# AI_GATEWAY_API_KEY=
# Model overrides, bare (claude-sonnet-5) or prefixed (anthropic/claude-sonnet-5).
# Both default to claude-sonnet-5. SCREEN_LLM_MODEL covers the
# compliance screen, and the code-name themes fall back to it when
# CODENAME_LLM_MODEL is unset — so setting SCREEN_LLM_MODEL alone moves both.
# SCREEN_LLM_MODEL=
# CODENAME_LLM_MODEL=

# Jev's second opinion on a send-time rule flag (D82/D87). Off unless the
# `mail_jev_second_opinion` flag is on AND AI_GATEWAY_API_KEY is set. The
# policy is provisional until Storm and Dan decide; an invalid value turns the
# feature off. Threshold: both of Jev's probabilities must be below it
# (default 0.05, at most 0.2). Clears: promissory_only (default, option B)
# or promissory_and_mnpi (option A). Never called in production until PR #346
# lands and TypeSafe's written zero-retention terms are in.
# JEV_SECOND_OPINION_THRESHOLD=0.05
# JEV_SECOND_OPINION_CLEARS=promissory_only

# Google Workspace reader (#259). Keyless: the worker impersonates the caller
# service account through workload identity federation, or through local ADC
# (`gcloud auth application-default login --impersonate-service-account=<caller SA>`).
# Never point this at a service-account key; the reader refuses one. See
# .secrets/README.md.
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/google/worker-credentials.json
# Optional directory identity (#344): a keyless config impersonating the
# directory service account. Unset, the group mirror asks IAM Credentials with
# the caller token. See docs/04-operations/dev-google-workspace-setup.md.
# GOOGLE_DIRECTORY_CREDENTIALS=
# Provider-neutral reader mode for the classification worker: fixture | live.
# No default. GRAPH_READER_PROVIDER (fixture | graph) remains an alias for one release.
# DISCOVERY_READER_MODE=
# fixture mode reads Gmail from a replay (refused in production). Optional: the
# replay directory (default tests/fixtures/discovery/gmail-twin) and the phase
# (default seeded; seed:discovery -- --google-replay reads after-unspam).
# DISCOVERY_GMAIL_REPLAY_DIR=
# DISCOVERY_GMAIL_REPLAY_PHASE=
